# ─────────────────────────────────────────────────────
#  AbrigoQR v4 · Configuracao
#  Copie como .env e preencha os valores
# ─────────────────────────────────────────────────────

# Entidade beneficiada
ENTIDADE_NOME=Lar dos Idosos Sao Francisco de Assis
ENTIDADE_CNPJ=12345678000199
ENTIDADE_LABEL=LAR DOS IDOSOS SAO FRANCISCO DE ASSIS

# Porta do servidor (Render injeta PORT automaticamente)
PORTA=8000

# Banco de dados
# Local:  sqlite:///./abrigoqr.db
# Render: postgres://user:pass@host:5432/dbname  (auto-injetado pelo Render)
DATABASE_URL=sqlite:///./abrigoqr.db

# CORS — em dev deixe *, em producao restrinja:
# CORS_ORIGINS=https://meuapp.com,capacitor://localhost,http://localhost
CORS_ORIGINS=*

# Token compartilhado entre o backend cloud e o local_rpa_worker.py
# Gere algo aleatorio: python -c "import secrets; print(secrets.token_urlsafe(32))"
RPA_TOKEN=troque-este-valor-por-um-secret-aleatorio

# IA (Claude) para leitura de imagens
# Obtenha em: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────
#  IMPORTANTE:
#  Nunca coloque senhas do gov.br aqui.
#  O login NFP e feito manualmente na 1a execucao do RPA local.
#  Cookies sao salvos em ./sessao_nfp/ automaticamente.
# ─────────────────────────────────────────────────────
