# ─────────────────────────────────────────────────────────
#  AbrigoQR v4 · Template de .env preenchido
#
#  Copie como `.env` e troque APENAS:
#    - ANTHROPIC_API_KEY  (cole sua chave do console.anthropic.com)
#    - RPA_TOKEN          (gere com: python -c "import secrets; print(secrets.token_urlsafe(32))")
#    - CLOUD_API_URL      (depois que o Render subir, cole a URL aqui)
#
#  Os campos da entidade ja vem corretos para a Casa de Amparo Bom Pastor.
# ─────────────────────────────────────────────────────────

# ─── Entidade beneficiada (NFP) ──────────────────────────
ENTIDADE_NOME="Casa de Amparo Para Idosos Bom Pastor"
ENTIDADE_CNPJ=05895268000152
ENTIDADE_LABEL="CASA DE AMPARO PARA IDOSOS BOM PASTOR"

# ─── Servidor local (uvicorn) ────────────────────────────
PORTA=8000

# ─── Banco ───────────────────────────────────────────────
# Local: SQLite (auto-criado).  Cloud: Render injeta DATABASE_URL=postgres://...
DATABASE_URL=sqlite:///./abrigoqr.db

# ─── CORS ────────────────────────────────────────────────
# Em producao, restrinja para a URL do app (capacitor://localhost) + dominio do Render.
CORS_ORIGINS=*

# ─── Token compartilhado (backend cloud <-> worker local) ─
# IMPORTANTE: o mesmo valor precisa estar no Render Dashboard.
# Quando o Render subir via render.yaml, ele gera um aleatorio - copie de la pra ca.
RPA_TOKEN=COLE-O-TOKEN-GERADO-PELO-RENDER-AQUI

# ─── Para o worker local (rodando contra o Render) ───────
# Apos o deploy, descomente e preencha:
# CLOUD_API_URL=https://abrigoqr-backend-XXXX.onrender.com
# POLL_INTERVAL=60
# LIMITE_LOTE=5

# ─── IA (Claude Vision) ──────────────────────────────────
# Obtenha em: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-COLE-SUA-CHAVE-AQUI

# ─────────────────────────────────────────────────────────
#  IMPORTANTE
#  - Nunca comite o arquivo .env (esta no .gitignore).
#  - Senhas do gov.br/certificado NFP NAO entram aqui — o RPA pede no
#    primeiro login e salva os cookies em ./sessao_nfp/.
# ─────────────────────────────────────────────────────────
